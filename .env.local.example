# ─────────────────────────────────────────────
# homelab — environment variables
# Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────

# Session secret — must be at least 32 characters, keep it private
SESSION_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# VMware Workstation vmrest executable path
# Default shown below; change if installed elsewhere
VMREST_PATH=C:\Program Files (x86)\VMware\VMware Workstation\vmrest.exe

# vmrest API credentials
# Run `vmrest.exe` once to set these interactively, then copy the values here
VMREST_USER=admin
VMREST_PASS=your_vmrest_password

# Next.js dev server port (default: 3000)
PORT=3000

# SSH WebSocket server port (default: 3001; change only if 3001 is taken)
# SSH_WS_PORT=3001
